{
    "executionRoleArn": "arn:aws:iam::585008044838:role/fynkus-ecs-task-execution-role",
    "containerDefinitions": [
        {
            "name": "api-nginx",
            "image": "ghcr.io/gcastval/fynkus-api-nginx:lts",
            "essential": true,
            "portMappings": [
                {
                    "hostPort": 8000,
                    "protocol": "tcp",
                    "containerPort": 8000
                }
            ],
            "logConfiguration": {
                "logDriver": "awslogs",
                "options": {
                    "awslogs-group": "/ecs/ecs-backend-task",
                    "awslogs-region": "eu-west-1",
                    "awslogs-stream-prefix": "api-nginx"
                }
            }
        },
        {
            "name": "api",
            "image": "ghcr.io/gcastval/fynkus-api:lts",
            "essential": true,
            "portMappings": [
                {
                    "hostPort": 9000,
                    "protocol": "tcp",
                    "containerPort": 9000
                }
            ],
            "logConfiguration": {
                "logDriver": "awslogs",
                "options": {
                    "awslogs-group": "/ecs/ecs-backend-task",
                    "awslogs-region": "eu-west-1",
                    "awslogs-stream-prefix": "api"
                }
            }
        }
    ],
    "requiresCompatibilities": [
        "FARGATE"
    ],
    "cpu": "256",
    "family": "backend",
    "memory": "1024",
    "networkMode": "awsvpc"
}